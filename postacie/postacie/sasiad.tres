[resource]
script = ExtResource("1_postac")
id = &"sasiad"
imie = "Pan Zenek"
rola = "sąsiad z trzeciego piętra"
opis = "Emeryt, stoi w kolejkach od świtu, więc zawsze coś ma. Lubi pogadać o pogodzie i o rządzie."
kolor = Color(0.55, 0.65, 0.35, 1)
czego_potrzebuje = Array[ExtResource("2_przedmiot")]([ExtResource("p_papierosy"), ExtResource("p_wodka")])
co_oferuje = Array[ExtResource("2_przedmiot")]([ExtResource("p_kawa"), ExtResource("p_kartki_zywnosciowe")])
relacja_startowa = 25
prog_wymiany = 40
powitanie = "O, sąsiad! Słyszał pan, że do mięsnego mają przywieźć? Nie? No to pan nic nie wie."
