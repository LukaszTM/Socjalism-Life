; Engine configuration file.
; It's automatically generated when the project is saved, and in Godot it's
; edited from the Project Settings dialog in the editor.

config_version=5

[application]

config/name="Socjalism Life"
config/description="Prototyp symulatora życia w państwie socjalistycznym. Gospodarka niedoboru: pieniądze są, towaru nie ma."
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://gra/swiat.tscn"
config/icon="res://icon.svg"

[autoload]

Zegar="*res://czas/zegar.tscn"
Potrzeby="*res://potrzeby/potrzeby.tscn"
Ekwipunek="*res://ekwipunek/ekwipunek.tscn"
Relacje="*res://postacie/relacje.tscn"
Statystyki="*res://statystyki/statystyki.tscn"
Zadanie="*res://zadanie/zadanie.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

